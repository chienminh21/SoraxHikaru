-- Notifications
---------------------------------------------------------------------
local Notifications = {
    _gui = nil,
    _holder = nil,
    _active = {},
    _order = 0,
    MAX_VISIBLE = 5,
}

local NOTIFY_COLORS = {
    info = Theme.Accent,
    success = Theme.Success,
    warning = Theme.Warning,
    error = Theme.Error,
}

function Notifications:ensure()
    if self._gui and self._gui.Parent then
        return
    end

    self._gui = new("ScreenGui", {
        Name = GUI_NAME .. "_Notify",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, get_gui_parent())

    -- Anchored to the top-right corner of the screen
    self._holder = new("Frame", {
        Name = "Holder",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.new(0, 300, 1, -24),
        BackgroundTransparency = 1,
    }, self._gui)

    new("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
    }, self._holder)

    -- Shrink on phones so notifications never overflow the screen
    local scale = new("UIScale", nil, self._holder)
    local function update_scale()
        local camera = workspace.CurrentCamera
        if not camera then return end
        scale.Scale = UserInputService.TouchEnabled and math.clamp(camera.ViewportSize.X / 1100, 0.7, 1) or 1
    end
    update_scale()
    if workspace.CurrentCamera then
        Connections["notify_scale"] = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update_scale)
    end
end

-- settings: { title, text, duration, type = "info" | "success" | "warning" | "error" }
function Notifications:send(settings)
    settings = settings or {}
    self:ensure()

    local kind = NOTIFY_COLORS[settings.type] and settings.type or "info"
    local color = NOTIFY_COLORS[kind]
    local duration = tonumber(settings.duration) or 4
    self._order += 1

    -- The wrapper is positioned by the list layout, the inner frame slides in and out
    local wrapper = new("Frame", {
        Name = "Notification",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = self._order,
    }, self._holder)

    local inner = new("Frame", {
        Name = "Inner",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(1, 40, 0, 0),
        BackgroundColor3 = Theme.Module,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
    }, wrapper)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, inner)
    new("UIStroke", { Color = Theme.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, inner)

    -- Colored bar on the left
    new("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, inner)

    local content = new("Frame", {
        Name = "Content",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, inner)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 9),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 14),
        PaddingRight = UDim.new(0, 10),
    }, content)
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, content)

    local function label(text, font, size, text_color, order)
        return new("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Font = font,
            TextSize = size,
            TextColor3 = text_color,
            Text = text,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = order,
        }, content)
    end

    if settings.title and settings.title ~= "" then
        label(tostring(settings.title), Enum.Font.GothamBold, 14, Theme.Text, 1)
    end
    if settings.text and settings.text ~= "" then
        label(tostring(settings.text), Enum.Font.Gotham, 12, Theme.SubText, 2)
    end

    -- Progress bar shows the remaining time
    local progress = new("Frame", {
        Name = "Progress",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = color,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, inner)

    local closing = false
    local entry = {}

    local function dismiss()
        if closing then return end
        closing = true

        local index = table.find(self._active, entry)
        if index then table.remove(self._active, index) end

        local out = TweenService:Create(inner, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 40, 0, 0),
            BackgroundTransparency = 1,
        })
        out:Play()
        out.Completed:Once(function()
            wrapper:Destroy()
        end)
    end
    entry.Dismiss = dismiss

    table.insert(self._active, entry)
    if #self._active > self.MAX_VISIBLE then
        self._active[1].Dismiss()
    end

    -- Click / tap to dismiss
    inner.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dismiss()
        end
    end)

    -- Slide in
    tween(inner, { Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.02 }, 0.4)

    -- Auto close when the progress bar runs out
    tween(progress, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, dismiss)

    return entry
end

function Notifications:clear()
    for _, entry in ipairs(table.clone(self._active)) do
        entry.Dismiss()
    end
end

function Notifications:destroy()
    table.clear(self._active)
    Connections:disconnect("notify_scale")
    if self._gui then
        self._gui:Destroy()
    end
    self._gui = nil
    self._holder = nil
end

