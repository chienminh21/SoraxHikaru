                        refresh(color)
                    end

                    local function close()
                        Connections:disconnect(move_key)
                        Connections:disconnect(end_key)
                        if Library._close_picker == close then
                            Library._close_picker = nil
                        end
                        Popup:Destroy()
                    end
                    Library._close_picker = close

                    -- Presets
                    local presets = { "6366F1", "EC4899", "EF4444", "A8A3C7", "D1D5DB" }
                    for index, hex in ipairs(presets) do
                        local preset_color = Color3.fromHex(hex)
                        local Dot = new("TextButton", {
                            Text = "",
                            AutoButtonColor = false,
                            Position = UDim2.fromOffset(196 + (index - 1) * 22, 231),
                            Size = UDim2.fromOffset(16, 16),
                            BackgroundColor3 = preset_color,
                            BorderSizePixel = 0,
                        }, Popup)
                        new("UICorner", { CornerRadius = UDim.new(1, 0) }, Dot)
                        new("UIStroke", { Color = Theme.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Dot)
                        Dot.MouseButton1Click:Connect(function()
                            set_color(preset_color)
                        end)
                    end

                    -- Dragging the square / hue bar (mouse and touch)
                    local function update_drag(position)
                        if drag_mode == "sv" then
                            sat = math.clamp((position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
                            val = 1 - math.clamp((position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
                            refresh()
                        elseif drag_mode == "hue" then
                            h = math.clamp((position.X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 1)
                            refresh()
                        end
                    end

                    local function is_press(input)
                        return input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.Touch
                    end

                    SV.InputBegan:Connect(function(input)
                        if is_press(input) then
                            drag_mode = "sv"
                            update_drag(input.Position)
                        end
                    end)

                    Hue.InputBegan:Connect(function(input)
                        if is_press(input) then
                            drag_mode = "hue"
                            update_drag(input.Position)
                        end
                    end)

                    Connections[move_key] = UserInputService.InputChanged:Connect(function(input)
                        if not drag_mode then return end
                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                            update_drag(input.Position)
                        end
                    end)

                    Connections[end_key] = UserInputService.InputEnded:Connect(function(input)
                        if is_press(input) then
                            drag_mode = nil
                        end
                    end)

                    -- Typed hex value
                    HexBox.FocusLost:Connect(function()
                        local text = (string.gsub(HexBox.Text, "[#%s]", ""))
                        local ok, parsed = pcall(Color3.fromHex, "#" .. text)
                        if ok and parsed then
                            set_color(parsed)
                        else
                            refresh(working) -- invalid input, restore the previous text
                        end
                    end)

                    CopyButton.MouseButton1Click:Connect(function()
                        if setclipboard then
                            setclipboard("#" .. string.upper(working:ToHex()))
                            Library.SendNotification({ title = "Copied", text = "#" .. string.upper(working:ToHex()), type = "info", duration = 2 })
                        else
                            Library.SendNotification({ title = "Copy not supported", text = "Your executor has no setclipboard", type = "warning", duration = 3 })
                        end
                    end)

                    CloseButton.MouseButton1Click:Connect(close)
                    Cancel.MouseButton1Click:Connect(close)

                    Confirm.MouseButton1Click:Connect(function()
                        commit(working)
                        if s.notify ~= false then
                            Library.SendNotification({ title = "Color updated!", type = "success", duration = 2 })
                        end
                        close()
                    end)

                    refresh(current)
                end

                Swatch.MouseButton1Click:Connect(open_popup)

                function ColorManager:Set(color)
                    commit(color)
                end

                function ColorManager:Get()
                    return current
                end

                pick_callback(current)

                return ColorManager
            end

            -------------------------------------------------------
            -- Button
            -------------------------------------------------------
            function ModuleManager:create_button(s)
                s = s or {}
                local button_callback = s.callback or function() end
                local order = reserve(27)

                local Button = new("TextButton", {
                    Name = "Button",
                    Font = Enum.Font.GothamSemibold,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    Text = s.title or "Button",
                    AutoButtonColor = false,
                    BackgroundColor3 = Theme.Item,
                    Size = UDim2.new(0, 207, 0, 22),
                    BorderSizePixel = 0,
                    LayoutOrder = order,
                }, Options)
                new("UICorner", { CornerRadius = UDim.new(0, 4) }, Button)
                new("UIStroke", { Color = Theme.Stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Button)

                Button.MouseEnter:Connect(function()
                    tween(Button, { BackgroundColor3 = Theme.ItemHover }, 0.2)
                end)
                Button.MouseLeave:Connect(function()
                    tween(Button, { BackgroundColor3 = Theme.Item }, 0.2)
                end)

                Button.MouseButton1Click:Connect(function()
                    local ok, err = pcall(button_callback)
                    if not ok then
                        warn("[Sora x Hikaru] button error:", err)
                    end
                end)

                return Button
            end

            return ModuleManager
        end

        return TabManager
    end

    ---------------------------------------------------------------
    -- Show / hide the window (PC key or the title area)
    ---------------------------------------------------------------
    Connections["library_visiblity"] = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode ~= TOGGLE_KEY then return end

        self._ui_open = not self._ui_open
        self:change_visiblity(self._ui_open)
    end)

    Minimize.MouseButton1Click:Connect(function()
        self._ui_open = not self._ui_open
        self:change_visiblity(self._ui_open)
    end)

    return self
end

return Library
