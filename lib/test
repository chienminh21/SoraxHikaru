    local dragging = false
    local drag_start, start_position

    DragBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            drag_start = input.Position
            start_position = Container.Position

            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    connection:Disconnect()
                end
            end)
        end
    end)

    Connections["window_drag"] = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - drag_start
            Container.Position = UDim2.new(
                start_position.X.Scale, start_position.X.Offset + delta.X,
                start_position.Y.Scale, start_position.Y.Offset + delta.Y
            )
        end
    end)

    self:removed(function()
        self._ui = nil
