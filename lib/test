                    LayoutOrder = 1,
                }, Box)

                local CurrentOption = new("TextLabel", {
                    Font = Enum.Font.GothamSemibold,
                    TextColor3 = Theme.Text,
                    Name = "CurrentOption",
                    Size = UDim2.new(0, 170, 0, 13),
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0.05, 0, 0.5, 0),
                    BackgroundTransparency = 1,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    TextSize = 10,
                    Text = "None",
                }, Header)

                local Arrow = new("ImageLabel", {
                    Name = "Arrow",
                    Image = "rbxassetid://84232453189324",
                    ImageColor3 = Theme.SubText,
                    AnchorPoint = Vector2.new(0, 0.5),
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0.91, 0, 0.5, 0),
                    Size = UDim2.new(0, 8, 0, 8),
                }, Header)

                local OptionList = new("ScrollingFrame", {
                    Name = "OptionList",
                    Active = true,
                    ScrollBarImageTransparency = 1,
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    ScrollBarThickness = 0,
                    Size = UDim2.new(0, 207, 0, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    LayoutOrder = 2,
                }, Box)
                new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, OptionList)
                new("UIPadding", { PaddingTop = UDim.new(0, -1), PaddingLeft = UDim.new(0, 10) }, OptionList)

                -- Update colors and the header text from the saved selection
                local function refresh_visuals()
                    local chosen = Library._config._flags[drop_flag]

                    for _, button in ipairs(OptionList:GetChildren()) do
                        if button:IsA("TextButton") then
                            local selected
                            if multi then
                                selected = type(chosen) == "table" and table.find(chosen, button.Text) ~= nil
                            else
                                selected = chosen == button.Text
                            end
                            button.TextColor3 = selected and Theme.Accent or Theme.SubText
                        end
                    end

                    if multi then
                        CurrentOption.Text = (type(chosen) == "table" and #chosen > 0) and table.concat(chosen, ", ") or "None"
                    else
                        CurrentOption.Text = chosen and tostring(chosen) or "None"
                    end
                end

                local function choose(value)
                    local name = name_of(value)

                    if multi then
                        local list = Library._config._flags[drop_flag]
                        if type(list) ~= "table" then
                            list = {}
                            Library._config._flags[drop_flag] = list
                        end

                        local index = table.find(list, name)
                        if index then
                            table.remove(list, index)
                        else
                            table.insert(list, name)
                        end

                        refresh_visuals()
                        save()
                        drop_callback(list)
                    else
                        Library._config._flags[drop_flag] = name
                        refresh_visuals()
                        save()
                        drop_callback(value)
                    end
                end

                -- (Re)create the option buttons
                local function build(list)
                    for _, child in ipairs(OptionList:GetChildren()) do
                        if child:IsA("TextButton") then
                            child:Destroy()
                        end
                    end

                    DropdownManager._size = 3

                    for index, value in ipairs(list) do
                        local Option = new("TextButton", {
                            Name = "Option",
                            Font = Enum.Font.GothamSemibold,
                            Active = false, -- click also reaches the dropdown, so it closes after choosing
                            TextSize = 10,
                            Size = UDim2.new(0, 186, 0, 16),
                            TextColor3 = Theme.SubText,
                            Text = name_of(value),
                            AutoButtonColor = false,
                            BackgroundTransparency = 1,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Selectable = false,
                            BorderSizePixel = 0,
                            LayoutOrder = index,
                        }, OptionList)

                        Option.MouseButton1Click:Connect(function()
                            choose(value)
                        end)

                        if index <= max_visible then
                            DropdownManager._size += 16
                        end
                    end

                    OptionList.Size = UDim2.fromOffset(207, DropdownManager._size)
                end

                function DropdownManager:update(option)
                    choose(option)
                end

                function DropdownManager:unfold_settings()
                    self._state = not self._state

                    if self._state then
                        self._open_size = self._size
                        ModuleManager._multiplier += self._open_size
                    else
                        ModuleManager._multiplier -= self._open_size
                        self._open_size = 0
                    end

                    tween(Module, { Size = UDim2.fromOffset(241, 93 + ModuleManager._size + ModuleManager._multiplier) })
                    tween(Options, { Size = UDim2.fromOffset(241, ModuleManager._size + ModuleManager._multiplier) })
                    tween(Dropdown, { Size = UDim2.fromOffset(207, 39 + self._open_size) })
                    tween(Box, { Size = UDim2.fromOffset(207, 22 + self._open_size) })
                    tween(Arrow, { Rotation = self._state and 180 or 0 })
                end

                -- Replace the option list at runtime (e.g. refresh a list of trees)
                function DropdownManager:SetValues(list)
                    if self._state then
                        self:unfold_settings()
                    end

                    options_list = list or {}
                    build(options_list)

                    local names = {}
                    for _, value in ipairs(options_list) do
                        names[name_of(value)] = true
                    end

                    local chosen = Library._config._flags[drop_flag]
                    if multi then
                        local kept = {}
                        if type(chosen) == "table" then
                            for _, name in ipairs(chosen) do
                                if names[name] then table.insert(kept, name) end
                            end
                        end
                        Library._config._flags[drop_flag] = kept
                        refresh_visuals()
                    elseif not (chosen and names[chosen]) and options_list[1] ~= nil then
                        choose(options_list[1])
                    else
                        refresh_visuals()
                    end
                end

                -- Old API: replace the dropdown with a new set of options
                function DropdownManager:New(new_settings)
                    self:SetValues((new_settings or {}).options)
                    return self
                end

                build(options_list)

                -- Initial selection
                local saved = Library._config._flags[drop_flag]
                if multi then
                    if type(saved) ~= "table" then
                        Library._config._flags[drop_flag] = {}
                    end
                    refresh_visuals()
                    drop_callback(Library._config._flags[drop_flag])
                else
                    local found
                    for _, value in ipairs(options_list) do
                        if name_of(value) == saved then
                            found = value
                            break
                        end
                    end
                    found = found or options_list[1]
                    if found ~= nil then
                        choose(found)
                    else
                        refresh_visuals()
                    end
                end

                Dropdown.MouseButton1Click:Connect(function()
                    DropdownManager:unfold_settings()
                end)

                return DropdownManager
            end

