            -------------------------------------------------------
            function ModuleManager:change_state(state)
                self._state = state

                tween(Module, {
                    Size = state and UDim2.fromOffset(241, 93 + self._size + self._multiplier) or UDim2.fromOffset(241, 93),
                })
                tween(Toggle, { BackgroundColor3 = state and Theme.Accent or Theme.ToggleOff })
                tween(Circle, { Position = state and UDim2.fromScale(0.53, 0.5) or UDim2.fromScale(0, 0.5) })

                if not settings.ignoresaved then
                    Library._config._flags[flag] = self._state
                    save()
                end

                callback(self._state)
            end

            -- Restore the saved state (unless the module opted out)
            if not settings.ignoresaved and Library._config._flags[flag] == true then
                ModuleManager._state = true
                Toggle.BackgroundColor3 = Theme.Accent
                Circle.Position = UDim2.fromScale(0.53, 0.5)
                callback(true)
            end

            bind_keybind(flag, Header, function()
                ModuleManager:change_state(not ModuleManager._state)
            end, function(text)
                text = text or "None"
                KeybindLabel.Text = text
                local width = text_size(text, 10, Enum.Font.GothamSemibold).X
                KeybindFrame.Size = UDim2.fromOffset(math.max(width + 10, 33), 15)
                KeybindLabel.Size = UDim2.fromOffset(width, 13)
            end)

