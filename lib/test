-- Helpers
---------------------------------------------------------------------
-- Create an Instance, apply properties, then parent it (parent last = faster)
local function new(class, props, parent)
    local object = Instance.new(class)
    if props then
        for key, value in pairs(props) do
            object[key] = value
        end
    end
    if parent then
        object.Parent = parent
    end
    return object
end

local function tween(object, props, duration, style, direction)
    TweenService:Create(
        object,
        TweenInfo.new(duration or 0.5, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        props
    ):Play()
end

local function get_gui_parent()
    local ok, ui = pcall(function() return gethui and gethui() end)
    if ok and ui then
        return ui
    end
    return CoreGui
end

local function text_size(text, size, font, width)
    return TextService:GetTextSize(text, size, font, Vector2.new(width or 1000, 10000))
end

local function strip_tags(text)
    return (string.gsub(text, "<[^>]+>", ""))
end

local function name_of(value)
    return typeof(value) == "string" and value or value.Name
end

