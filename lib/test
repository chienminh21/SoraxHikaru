    -- Set window transparency ("nil" resets to default)
    function self:Update1Run(value)
        if value == "nil" then
            Container.BackgroundTransparency = 0.05
        else
            pcall(function()
                Container.BackgroundTransparency = tonumber(value)
            end)
        end
    end

    -- Show / hide the whole UI instantly
    function self:UIVisiblity()
        ScreenGui.Enabled = not ScreenGui.Enabled
    end

    -- Expand / minimize the window
    function self:change_visiblity(state)
        if state then
            tween(Container, { Size = UDim2.fromOffset(698, 479) })
        else
            tween(Container, { Size = UDim2.fromOffset(150, 40) })
        end
    end

    -- Completely remove the UI, notifications, blur and connections
    function self:Unload()
        Connections:disconnect_all()
        if self._blur then
            self._blur:destroy()
            self._blur = nil
        end
        Notifications:destroy()
        if self._ui then
            self._ui:Destroy()
            self._ui = nil
        end
        if env.SxH_UI == self then
            env.SxH_UI = nil
        end
    end

    -- Call once after all tabs are created
    function self:load()
        local images = {}
        for _, object in ipairs(ScreenGui:GetDescendants()) do
            if object:IsA("ImageLabel") then
                table.insert(images, object)
            end
        end
        pcall(function() ContentProvider:PreloadAsync(images) end)

        self:get_device()

        -- Scale the window on phones
        if self._device == "Mobile" or self._device == "Unknown" then
            self:get_screen_scale()
            UIScale.Scale = self._ui_scale

            Connections["ui_scale"] = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
                self:get_screen_scale()
                UIScale.Scale = self._ui_scale
            end)
        end

        -- Floating button to open / close the window on touch devices (no keyboard)
        if self._device == "Mobile" then
            local button = new("TextButton", {
                Name = "MobileToggle",
                Text = "SxH",
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextColor3 = Theme.White,
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.fromOffset(44, 44),
                Position = UDim2.new(0, 8, 0.5, -22),
                AutoButtonColor = true,
            }, ScreenGui)
            new("UICorner", { CornerRadius = UDim.new(1, 0) }, button)
            button.MouseButton1Click:Connect(function()
                self._ui_open = not self._ui_open
                self:change_visiblity(self._ui_open)
            end)
        end

        tween(Container, { Size = UDim2.fromOffset(698, 479) })

        if USE_BLUR then
            self._blur = AcrylicBlur.new(Container)
        end

        self._ui_loaded = true
    end

    -- Highlight the selected tab, fade the others
    function self:update_tabs(selected)
        for _, object in ipairs(Tabs:GetChildren()) do
            if object.Name ~= "Tab" then continue end

            local active = object == selected

            tween(object, { BackgroundTransparency = active and 0 or 1 })
            tween(object.TextLabel, { TextColor3 = active and Theme.Accent or Theme.SubText })
            tween(object.Icon, { ImageColor3 = active and Theme.Accent or Theme.SubText })

            if active then
                tween(Pin, { Position = UDim2.new(0.026, 0, 0, 64 + object.LayoutOrder * 42) })
            end
        end
    end

    -- Show only the sections of the selected tab
    function self:update_sections(left_section, right_section)
        for _, object in ipairs(Sections:GetChildren()) do
            object.Visible = (object == left_section or object == right_section)
        end
    end

