-- Connections manager
---------------------------------------------------------------------
local Connections = {}

function Connections:disconnect(name)
    local connection = self[name]
    if typeof(connection) == "RBXScriptConnection" then
        connection:Disconnect()
    end
    self[name] = nil
end

function Connections:disconnect_all()
    for key, value in pairs(self) do
        if typeof(value) == "RBXScriptConnection" then
            value:Disconnect()
            self[key] = nil
        end
    end
end

---------------------------------------------------------------------
-- Util
---------------------------------------------------------------------
local Util = {}

function Util:map(value, in_min, in_max, out_min, out_max)
    return (value - in_min) * (out_max - out_min) / (in_max - in_min) + out_min
end

function Util:viewport_point_to_world(location, distance)
    local unit_ray = workspace.CurrentCamera:ScreenPointToRay(location.X, location.Y)
    return unit_ray.Origin + unit_ray.Direction * distance
end

function Util:get_offset()
    local viewport_size_y = workspace.CurrentCamera.ViewportSize.Y
    return self:map(viewport_size_y, 0, 2560, 8, 56)
end

---------------------------------------------------------------------
-- Acrylic blur (blurs the 3D world behind the window)
---------------------------------------------------------------------
local AcrylicBlur = {}
AcrylicBlur.__index = AcrylicBlur

function AcrylicBlur.new(object)
    local self = setmetatable({ _object = object }, AcrylicBlur)
    self:setup()
    return self
end

function AcrylicBlur:setup()
    local camera = workspace.CurrentCamera

    -- Remove leftovers of an older instance
    local old_folder = camera:FindFirstChild("SxH_AcrylicBlur")
    if old_folder then old_folder:Destroy() end

    -- Depth of field does the actual blur
    local dof = Lighting:FindFirstChild("SxH_AcrylicBlur") or Instance.new("DepthOfFieldEffect")
    dof.FarIntensity = 0
    dof.FocusDistance = 0.05
    dof.InFocusRadius = 0.1
    dof.NearIntensity = 1
    dof.Name = "SxH_AcrylicBlur"
    dof.Parent = Lighting
    self._dof = dof

    -- Stop other depth-of-field effects from blurring the far distance
    for _, object in ipairs(Lighting:GetChildren()) do
        if object:IsA("DepthOfFieldEffect") and object ~= dof then
            Connections[object] = object:GetPropertyChangedSignal("FarIntensity"):Connect(function()
                object.FarIntensity = 0
            end)
            object.FarIntensity = 0
        end
    end

    -- Thin glass part that follows the window
    self._folder = new("Folder", { Name = "SxH_AcrylicBlur" }, camera)
    self._root = new("Part", {
        Name = "Root",
        Color = Color3.new(1, 1, 1),
        Material = Enum.Material.Glass,
        Size = Vector3.new(1, 1, 0),
        Anchored = true,
        CanCollide = false,
        CanQuery = false,
        Locked = true,
        CastShadow = false,
        Transparency = 0.98,
    }, self._folder)
    new("SpecialMesh", {
        MeshType = Enum.MeshType.Brick,
        Offset = Vector3.new(0, 0, -0.000001), -- tiny offset prevents z-fighting
    }, self._root)

    self._frame = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
    }, self._object)

    self:render(0.001)
    self:check_quality_level()
end

function AcrylicBlur:render(distance)
    local positions = {
        top_left = Vector2.new(),
        top_right = Vector2.new(),
        bottom_right = Vector2.new(),
    }

    local function update()
        if not self._root then return end
        local camera = workspace.CurrentCamera

        local top_left3D = Util:viewport_point_to_world(positions.top_left, distance)
        local top_right3D = Util:viewport_point_to_world(positions.top_right, distance)
        local bottom_right3D = Util:viewport_point_to_world(positions.bottom_right, distance)

        local width = (top_right3D - top_left3D).Magnitude
        local height = (top_right3D - bottom_right3D).Magnitude

        self._root.CFrame = CFrame.fromMatrix(
            (top_left3D + bottom_right3D) / 2,
            camera.CFrame.XVector,
            camera.CFrame.YVector,
            camera.CFrame.ZVector
        )
        self._root.Mesh.Scale = Vector3.new(width, height, 0)
    end

    local function on_change()
        local offset = Util:get_offset()
        local size = self._frame.AbsoluteSize - Vector2.new(offset, offset)
        local position = self._frame.AbsolutePosition + Vector2.new(offset / 2, offset / 2)

        positions.top_left = position
        positions.top_right = position + Vector2.new(size.X, 0)
        positions.bottom_right = position + size

        task.spawn(update)
    end

    local camera = workspace.CurrentCamera
    Connections["blur_cframe"] = camera:GetPropertyChangedSignal("CFrame"):Connect(update)
    Connections["blur_viewport"] = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
    Connections["blur_fov"] = camera:GetPropertyChangedSignal("FieldOfView"):Connect(update)
    Connections["blur_position"] = self._frame:GetPropertyChangedSignal("AbsolutePosition"):Connect(on_change)
    Connections["blur_size"] = self._frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(on_change)

    task.spawn(on_change)
end

function AcrylicBlur:check_quality_level()
    local ok, game_settings = pcall(function() return UserSettings().GameSettings end)
    if not ok then return end

    -- Blur is disabled on low graphics quality
    if game_settings.SavedQualityLevel.Value < 8 then
        self:change_visiblity(false)
    end

    Connections["blur_quality"] = game_settings:GetPropertyChangedSignal("SavedQualityLevel"):Connect(function()
        self:change_visiblity(game_settings.SavedQualityLevel.Value >= 8)
    end)
end

function AcrylicBlur:change_visiblity(state)
    if self._root then
        self._root.Transparency = state and 0.98 or 1
    end
end

function AcrylicBlur:destroy()
    if self._folder then self._folder:Destroy() end
    if self._dof then self._dof:Destroy() end
    self._root = nil
end

---------------------------------------------------------------------
-- Config (saved to FOLDER/<GameId>.json)
---------------------------------------------------------------------
local Config = {}

function Config:save(file_name, config)
    if not writefile then return end
    local ok, err = pcall(function()
        writefile(FOLDER .. "/" .. tostring(file_name) .. ".json", HttpService:JSONEncode(config))
    end)
    if not ok then
        warn("[Sora x Hikaru] failed to save config:", err)
    end
end

function Config:load(file_name)
    local default = { _flags = {}, _keybinds = {}, _library = {} }
    if not (isfile and readfile) then return default end

    local ok, result = pcall(function()
        local path = FOLDER .. "/" .. tostring(file_name) .. ".json"
        if not isfile(path) then return nil end
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(result) ~= "table" then
        return default
    end

    result._flags = result._flags or {}
    result._keybinds = result._keybinds or {}
    result._library = result._library or {}
    return result
end

