            -- Keep Module / Options heights in sync with the controls inside
            local function refresh_size()
                if ModuleManager._state then
                    Module.Size = UDim2.fromOffset(241, 93 + ModuleManager._size + ModuleManager._multiplier)
                end
                Options.Size = UDim2.fromOffset(241, ModuleManager._size + ModuleManager._multiplier)
            end

            -- Reserve vertical space for a new control, returns its layout order
            local function reserve(height)
                LayoutOrderModule += 1
                if ModuleManager._size == 0 then
                    ModuleManager._size = 11
                end
                ModuleManager._size += height
                refresh_size()
                return LayoutOrderModule
            end

            local function save()
                Config:save(game.GameId, Library._config)
            end

            -- Middle mouse click on `target` assigns a key, Backspace clears it
            local function bind_keybind(bind_flag, target, on_press, on_label)
                local function label_text()
                    local key = Library._config._keybinds[bind_flag]
                    if not key then return nil end
                    return (string.gsub(key, "Enum.KeyCode.", ""))
                end

                on_label(label_text())

                Connections[bind_flag .. "_keybind"] = UserInputService.InputBegan:Connect(function(input, processed)
                    if processed or Library._choosing_keybind then return end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if tostring(input.KeyCode) == Library._config._keybinds[bind_flag] then
                        on_press()
                    end
                end)

                target.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseButton3 then return end
                    if Library._choosing_keybind then return end

                    Library._choosing_keybind = true
                    on_label("...")

                    local connection
                    connection = UserInputService.InputBegan:Connect(function(key)
                        if key.UserInputType ~= Enum.UserInputType.Keyboard then return end
                        if key.KeyCode == Enum.KeyCode.Unknown then return end

                        connection:Disconnect()

                        if key.KeyCode == Enum.KeyCode.Backspace then
                            Library._config._keybinds[bind_flag] = nil
                        else
                            Library._config._keybinds[bind_flag] = tostring(key.KeyCode)
                        end

                        save()
                        Library._choosing_keybind = false
                        on_label(label_text())
                    end)
                end)
            end

