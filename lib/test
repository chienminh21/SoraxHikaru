            function ModuleManager:create_slider(s)
                s = s or {}
                local slider_flag = s.flag or s.title or "slider"
                local slider_callback = s.callback or function() end
                local min_value = s.minimum_value or 0
                local max_value = s.maximum_value or 100
                local order = reserve(27)

                local Slider = new("TextButton", {
                    Name = "Slider",
                    Text = "",
                    AutoButtonColor = false,
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 207, 0, 22),
                    BorderSizePixel = 0,
                    LayoutOrder = order,
                }, Options)

                new("TextLabel", {
                    Font = Enum.Font.GothamSemibold,
                    TextSize = 11,
                    TextColor3 = Theme.Text,
                    Text = s.title or "Slider",
                    Size = UDim2.new(0, 153, 0, 13),
                    Position = UDim2.new(0, 0, 0.05, 0),
                    BackgroundTransparency = 1,
                    TextXAlignment = Enum.TextXAlignment.Left,
                }, Slider)

                local Value = new("TextLabel", {
                    Name = "Value",
                    Font = Enum.Font.GothamSemibold,
                    TextColor3 = Theme.SubText,
                    Text = "",
                    Size = UDim2.new(0, 42, 0, 13),
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    BackgroundTransparency = 1,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    TextSize = 10,
                }, Slider)

                local Drag = new("Frame", {
                    Name = "Drag",
                    AnchorPoint = Vector2.new(0.5, 1),
                    BackgroundColor3 = Theme.Stroke,
                    Position = UDim2.new(0.5, 0, 0.95, 0),
                    Size = UDim2.new(0, 207, 0, 4),
                    BorderSizePixel = 0,
                }, Slider)
                new("UICorner", { CornerRadius = UDim.new(1, 0) }, Drag)

                local Fill = new("Frame", {
                    Name = "Fill",
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(0.5, 0, 0, 4),
                    BorderSizePixel = 0,
                    BackgroundColor3 = Theme.Accent,
                }, Drag)
                new("UICorner", { CornerRadius = UDim.new(0, 3) }, Fill)

                local Knob = new("Frame", {
                    Name = "Circle",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.new(0, 10, 0, 10),
                    BorderSizePixel = 0,
                    BackgroundColor3 = Theme.White,
                }, Fill)
                new("UICorner", { CornerRadius = UDim.new(1, 0) }, Knob)
                new("UIStroke", { Color = Theme.Accent, Thickness = 1.5 }, Knob)

                local function apply(value)
                    value = math.clamp(value, min_value, max_value)
                    if s.round_number then
                        value = math.floor(value + 0.5)
                    else
                        value = math.floor(value * 10 + 0.5) / 10
                    end

                    local percentage = (max_value == min_value) and 0 or (value - min_value) / (max_value - min_value)
                    Value.Text = tostring(value)
                    tween(Fill, { Size = UDim2.new(math.clamp(percentage, 0.02, 1), 0, 0, 4) }, 0.2)

                    if not s.ignoresaved then
                        Library._config._flags[slider_flag] = value
                    end
                    slider_callback(value)
                end

                local function from_x(x)
                    local percentage = math.clamp((x - Drag.AbsolutePosition.X) / Drag.AbsoluteSize.X, 0, 1)
                    apply(min_value + (max_value - min_value) * percentage)
                end

                local dragging = false

                Slider.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        from_x(input.Position.X)

                        local connection
                        connection = input.Changed:Connect(function()
                            if input.UserInputState == Enum.UserInputState.End then
                                dragging = false
                                connection:Disconnect()
                                if not s.ignoresaved then save() end
                            end
                        end)
                    end
                end)

                Connections["slider_" .. slider_flag] = UserInputService.InputChanged:Connect(function(input)
                    if not dragging then return end
                    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        from_x(input.Position.X)
                    end
                end)

                -- Initial value: saved one, otherwise the default
                local saved = Library._config._flags[slider_flag]
                if not s.ignoresaved and type(saved) == "number" then
                    apply(saved)
                else
                    apply(s.value or min_value)
                end

                return { set = apply }
            end

