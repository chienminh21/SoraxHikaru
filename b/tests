+            if matches then
+                local score = 0
+                local first = terms[1]
+                if first then
+                    if title == first then
+                        score = 3
+                    elseif string.sub(title, 1, #first) == first then
+                        score = 2
+                    elseif string.find(title, first, 1, true) then
+                        score = 1
+                    end
+                end
+                if entry.Kind == 'Module' then
